# Copy to .env on the assigned Amazon Linux host and replace every placeholder.
STUDENT_ID=your-id
APP_IMAGE=laravel-your-id:1.0
APP_PORT=8081
PMA_PORT=9081
MYSQL_PORT=33061

APP_NAME="Laravel your-id"
APP_KEY=REPLACE_WITH_ARTISAN_KEY
APP_URL=http://REPLACE_WITH_YOUR_EC2_ADDRESS:8081

DB_DATABASE=yourdb
DB_USERNAME=yourdb
DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD
